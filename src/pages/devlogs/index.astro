---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('devlog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDateUTC(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<Layout
  title="Devlogs | Agogpixel"
  description="Engineering dispatches, architecture breakdowns, and game development progress from Agogpixel."
  scrollable={true}
>
  <section class="relative w-full max-w-5xl mx-auto px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <!-- Catalog Header -->
    <header class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 border-b border-cosmos-600 pb-6 mb-10">
      <hgroup>
        <p class="font-mono text-xs uppercase tracking-widest text-brand-lunar mb-1.5">
          [ Building an A- Studio in Public ]
        </p>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-brand-starlight font-sans">
          Engineering Devlogs
        </h1>
        <p class="mt-2 text-sm sm:text-base text-brand-lunar max-w-2xl">
          Technical dispatches, systems architecture, and transparent progress logs from our game and studio engineering tracks.
        </p>
      </hgroup>

      <!-- Direct RSS Subscription Button -->
      <a
        href="/rss.xml"
        role="button"
        class="inline-flex items-center gap-2 self-start sm:self-auto rounded border border-brand-amber bg-cosmos-950 px-3.5 py-2 font-mono text-xs font-semibold text-brand-amber-ui transition-colors hover:bg-brand-amber-dark hover:border-brand-amber-ui"
        title="Subscribe to Agogpixel Devlogs RSS Feed"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="h-4 w-4 text-brand-amber-ui"
          aria-hidden="true"
        >
          <path d="M3.75 3a.75.75 0 0 0-.75.75v.5c0 .414.336.75.75.75H4c8.284 0 15 6.716 15 15v.25c0 .414.336.75.75.75h.5a.75.75 0 0 0 .75-.75V20C21 10.611 13.389 3 4 3h-.25Z" />
          <path d="M3.75 10a.75.75 0 0 0-.75.75v.5c0 .414.336.75.75.75H4a8 8 0 0 1 8 8v.25c0 .414.336.75.75.75h.5a.75.75 0 0 0 .75-.75V20c0-5.523-4.477-10-10-10h-.25Z" />
          <circle cx="5" cy="19" r="2" />
        </svg>
        <span>RSS Feed</span>
      </a>
    </header>

    <!-- Devlog Post List / Grid -->
    {posts.length === 0 ? (
      <div class="rounded border border-cosmos-600 bg-cosmos-950 p-10 sm:p-14 text-center">
        <p class="font-mono text-sm text-brand-cyan mb-2">No dispatches published yet</p>
        <p class="text-sm sm:text-base text-brand-lunar max-w-lg mx-auto">
          Engineering devlogs are on the way. Subscribe via the RSS feed above to get notified when our first entry goes live.
        </p>
      </div>
    ) : (
      <div class="grid gap-6">
        {posts.map((post) => (
          <article class="group relative rounded border border-cosmos-600 bg-cosmos-950 p-6 sm:p-8 transition-colors hover:border-brand-charcoal hover:bg-cosmos-900">
            <div class="flex flex-wrap items-center justify-between gap-3 text-xs font-mono mb-3">
              <!-- Track / Category Badge -->
              <span class="inline-flex items-center rounded border border-brand-cyan/40 bg-brand-cyan-dark/40 px-2.5 py-0.5 font-medium text-brand-cyan">
                {post.data.track}
              </span>

              <!-- UTC-Safe Publication Date -->
              <time
                datetime={post.data.pubDate.toISOString()}
                class="text-brand-lunar"
              >
                {formatDateUTC(post.data.pubDate)}
              </time>
            </div>

            <!-- Post Title -->
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-brand-starlight group-hover:text-brand-cyan transition-colors">
              <a href={`/devlogs/${post.slug}/`} class="focus:outline-none">
                <span class="absolute inset-0" aria-hidden="true"></span>
                {post.data.title}
              </a>
            </h2>

            <!-- Summary Description -->
            <p class="mt-3 text-sm sm:text-base text-brand-starlight leading-relaxed">
              {post.data.summary}
            </p>

            <!-- Footer Meta: Tags & Read Indicator -->
            <div class="mt-5 pt-4 border-t border-cosmos-600 flex flex-wrap items-center justify-between gap-4">
              <div class="flex flex-wrap items-center gap-2">
                {post.data.tags.map((tag) => (
                  <span class="rounded bg-cosmos-900 px-2 py-0.5 font-mono text-xs text-brand-lunar border border-cosmos-600">
                    #{tag}
                  </span>
                ))}
              </div>

              <span class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold text-brand-amber-ui transition-colors group-hover:text-brand-amber">
                <span>Read Dispatch</span>
                <span aria-hidden="true">&rarr;</span>
              </span>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</Layout>
