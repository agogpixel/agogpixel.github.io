---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const devlogs = await getCollection('devlog');
const sortedDevlogs = devlogs.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Devlogs | Agogpixel Studio"
  description="Follow Agogpixel Studio's public engineering logs, game mechanics deep-dives, and AI-accelerated studio development."
>
  <div class="py-16 md:py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 rounded-full border border-cyber-cyan/30 bg-void-900/80 px-4 py-1.5 font-mono text-xs text-cyber-cyan mb-4">
          <span>Public Engineering Hub</span>
        </div>
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl font-sans">
          Building an "A-" Studio in Public
        </h1>
        <p class="mt-4 text-slate-300 text-base sm:text-lg">
          Raw notes, architectural decisions, and post-mortems from our indie game production and AI pair-programming experiments.
        </p>
      </div>

      <!-- Devlog Track Spotlight -->
      <div class="mb-12 rounded-xl border border-cyber-cyan/30 bg-void-900/60 p-6 md:p-8">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div>
            <span class="font-mono text-xs uppercase tracking-widest text-cyber-cyan font-bold">Featured Track</span>
            <h2 class="text-xl font-bold text-white mt-1">Autonomous Subagent Development & Godot 4.4</h2>
            <p class="text-sm text-slate-400 mt-2 max-w-2xl">
              Documenting how we build production-ready Godot games and web portals using specialized AI subagents with strict git workflows.
            </p>
          </div>
          <div class="font-mono text-xs text-slate-500">
            {sortedDevlogs.length} Published Entry
          </div>
        </div>
      </div>

      <!-- Devlog List -->
      <div class="space-y-6">
        {sortedDevlogs.map((entry) => (
          <article class="group rounded-xl border border-void-800 bg-void-900/40 p-6 hover:border-cyber-cyan/40 hover:bg-void-900/80 transition-all duration-200">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-slate-500 mb-3">
              <div class="flex items-center gap-2">
                <span class="rounded bg-void-800 px-2.5 py-0.5 text-cyber-cyan font-semibold">
                  {entry.data.track}
                </span>
                <span>•</span>
                <span>{entry.data.author}</span>
              </div>
              <time datetime={entry.data.pubDate.toISOString()}>
                {entry.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-cyber-cyan transition-colors">
              <a href={`/devlogs/${entry.slug}/`}>
                {entry.data.title}
              </a>
            </h3>

            <p class="mt-2 text-sm text-slate-300 leading-relaxed">
              {entry.data.summary}
            </p>

            <div class="mt-4 flex flex-wrap items-center justify-between gap-4 pt-2 border-t border-void-800/60">
              <div class="flex flex-wrap gap-1.5 font-mono text-[11px]">
                {entry.data.tags.map((tag) => (
                  <span class="rounded bg-void-950 border border-void-800 px-2 py-0.5 text-slate-400">
                    #{tag}
                  </span>
                ))}
              </div>
              <a
                href={`/devlogs/${entry.slug}/`}
                class="inline-flex items-center gap-1 font-mono text-xs font-semibold text-cyber-cyan hover:underline"
              >
                <span>Read Full Devlog</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</Layout>
