---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const devlogs = await getCollection('devlog');
  return devlogs.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout
  title={`${entry.data.title} | Agogpixel Devlogs`}
  description={entry.data.summary}
>
  <article class="py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <!-- Article Header -->
      <header class="mb-12 border-b border-void-800 pb-8">
        <a
          href="/devlogs/"
          class="inline-flex items-center gap-1 font-mono text-xs text-cyber-cyan hover:underline mb-6"
        >
          ← Back to All Devlogs
        </a>

        <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-slate-400 mb-3">
          <span class="rounded bg-void-800 px-2.5 py-0.5 text-cyber-cyan font-semibold">
            {entry.data.track}
          </span>
          <span>•</span>
          <time datetime={entry.data.pubDate.toISOString()}>
            {entry.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          <span>•</span>
          <span>By {entry.data.author}</span>
        </div>

        <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl font-sans">
          {entry.data.title}
        </h1>

        <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed font-sans">
          {entry.data.summary}
        </p>

        <div class="mt-6 flex flex-wrap gap-2 font-mono text-xs">
          {entry.data.tags.map((tag) => (
            <span class="rounded bg-void-950 border border-void-800 px-2 py-0.5 text-slate-400">
              #{tag}
            </span>
          ))}
        </div>
      </header>

      <!-- Markdown Prose Content -->
      <div class="prose prose-invert prose-cyber max-w-none prose-headings:font-sans prose-headings:text-white prose-p:text-slate-300 prose-p:leading-relaxed prose-a:text-cyber-cyan prose-code:text-cyber-cyan prose-pre:border prose-pre:border-void-800 prose-pre:bg-void-950">
        <Content />
      </div>
    </div>
  </article>
</Layout>
