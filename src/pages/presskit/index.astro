---
import Layout from '../../layouts/Layout.astro';
import MascotRocket from '../../components/MascotRocket.astro';
---

<Layout
  title="Press Kit | Agogpixel Studio"
  description="Agogpixel Studio press facts, brand assets, color specifications, and media downloads."
>
  <div class="py-16 md:py-28">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="mb-16 text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 rounded-full border border-brand-cyan/30 bg-cosmos-900/90 px-4 py-1.5 font-mono text-xs text-brand-cyan mb-4">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand-cyan animate-pulse"></span>
          <span>Media & Resources</span>
        </div>
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl font-sans">
          Press Kit
        </h1>
        <p class="mt-4 text-slate-300 text-base sm:text-lg font-sans">
          Everything you need to cover Agogpixel Studio, our projects, and brand assets.
        </p>
      </div>

      <div class="space-y-12">
        <!-- Studio Factsheet -->
        <section class="rounded-2xl border border-cosmos-800 bg-cosmos-900/50 p-6 md:p-8">
          <h2 class="text-xl font-bold text-white font-sans mb-4">Factsheet</h2>
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-xs">
            <div class="rounded-lg border border-cosmos-800 bg-cosmos-950 p-3.5">
              <dt class="text-slate-400">Studio Name</dt>
              <dd class="text-white font-bold mt-1">Agogpixel Studio</dd>
            </div>
            <div class="rounded-lg border border-cosmos-800 bg-cosmos-950 p-3.5">
              <dt class="text-slate-400">Studio Classification</dt>
              <dd class="text-brand-cyan font-bold mt-1">A- Independent Game Studio</dd>
            </div>
            <div class="rounded-lg border border-cosmos-800 bg-cosmos-950 p-3.5">
              <dt class="text-slate-400">Website</dt>
              <dd class="text-brand-cyan font-bold mt-1">
                <a href="https://agogpixel.com" target="_blank">agogpixel.com</a>
              </dd>
            </div>
            <div class="rounded-lg border border-cosmos-800 bg-cosmos-950 p-3.5">
              <dt class="text-slate-400">Tagline</dt>
              <dd class="text-slate-200 font-bold mt-1">AAA ambition. Indie grit. Minus the corporate bloat.</dd>
            </div>
            <div class="rounded-lg border border-cosmos-800 bg-cosmos-950 p-3.5">
              <dt class="text-slate-400">Heritage Motto</dt>
              <dd class="text-slate-200 font-bold mt-1">Curious Software Development</dd>
            </div>
            <div class="rounded-lg border border-cosmos-800 bg-cosmos-950 p-3.5">
              <dt class="text-slate-400">Debut Project</dt>
              <dd class="text-brand-amber font-bold mt-1">Escape from Cygnus X-1 (In Development)</dd>
            </div>
          </dl>
        </section>

        <!-- Studio Description / Boilerplate -->
        <section class="rounded-2xl border border-cosmos-800 bg-cosmos-900/50 p-6 md:p-8">
          <h2 class="text-xl font-bold text-white font-sans mb-4">Studio Boilerplate</h2>
          <div class="rounded-xl border border-cosmos-800 bg-cosmos-950 p-5 text-sm text-slate-300 leading-relaxed font-sans">
            "Agogpixel Studio is an independent game development studio creating high-velocity retro sci-fi arcade experiences with tight mechanics, authentic game feel, and curious software. Agogpixel adheres to the 'A-' Standard: delivering lean, high-rigor engineering, minus the corporate bloat."
          </div>
        </section>

        <!-- Brand & Mascot Assets -->
        <section class="rounded-2xl border border-cosmos-800 bg-cosmos-900/50 p-6 md:p-8">
          <h2 class="text-xl font-bold text-white font-sans mb-4">Branding & Mascot Assets</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div class="rounded-xl border border-cosmos-800 bg-cosmos-950 p-5 flex flex-col items-center text-center">
              <div class="h-24 flex items-center justify-center">
                <img src="/assets/rocket_guinea_pig.png" alt="Mascot Rocket PNG" class="h-16 w-16 object-contain" />
              </div>
              <div class="font-mono text-xs text-white font-bold mt-2">Mascot Rocket (PNG)</div>
              <a href="/assets/rocket_guinea_pig.png" download class="mt-3 font-mono text-xs text-brand-cyan hover:underline">
                Download PNG ↓
              </a>
            </div>

            <div class="rounded-xl border border-cosmos-800 bg-cosmos-950 p-5 flex flex-col items-center text-center">
              <div class="h-24 flex items-center justify-center">
                <img src="/assets/rocket_guinea_pig.svg" alt="Mascot Rocket SVG" class="h-16 w-16 object-contain" />
              </div>
              <div class="font-mono text-xs text-white font-bold mt-2">Vector Rocket (SVG)</div>
              <a href="/assets/rocket_guinea_pig.svg" download class="mt-3 font-mono text-xs text-brand-cyan hover:underline">
                Download SVG ↓
              </a>
            </div>

            <div class="rounded-xl border border-cosmos-800 bg-cosmos-950 p-5 flex flex-col items-center text-center">
              <div class="h-24 flex items-center justify-center">
                <MascotRocket size="sm" animated={true} />
              </div>
              <div class="font-mono text-xs text-white font-bold mt-2">Animated Mascot</div>
              <a href="/assets/rocket_guinea_pig_animated.gif" download class="mt-3 font-mono text-xs text-brand-cyan hover:underline">
                Download GIF ↓
              </a>
            </div>
          </div>
        </section>

        <!-- Studio Color Palette (Brand Identity Guide Specification) -->
        <section class="rounded-2xl border border-cosmos-800 bg-cosmos-900/50 p-6 md:p-8">
          <h2 class="text-xl font-bold text-white font-sans mb-4">Official Studio Color Palette</h2>
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-4 font-mono text-xs">
            <div class="rounded-xl border border-cosmos-800 bg-cosmos-950 p-3">
              <div class="h-10 w-full rounded bg-[#030303] border border-cosmos-800 mb-2"></div>
              <div class="font-bold text-white">Cosmos Black</div>
              <div class="text-slate-400">#030303</div>
            </div>
            <div class="rounded-xl border border-cosmos-800 bg-cosmos-950 p-3">
              <div class="h-10 w-full rounded bg-[#C97320] mb-2"></div>
              <div class="font-bold text-white">Thruster Amber</div>
              <div class="text-slate-400">#C97320</div>
            </div>
            <div class="rounded-xl border border-cosmos-800 bg-cosmos-950 p-3">
              <div class="h-10 w-full rounded bg-[#4CC9F0] mb-2"></div>
              <div class="font-bold text-white">Porthole Cyan</div>
              <div class="text-slate-400">#4CC9F0</div>
            </div>
            <div class="rounded-xl border border-cosmos-800 bg-cosmos-950 p-3">
              <div class="h-10 w-full rounded bg-[#E63946] mb-2"></div>
              <div class="font-bold text-white">Rocket Scarlet</div>
              <div class="text-slate-400">#E63946</div>
            </div>
            <div class="rounded-xl border border-cosmos-800 bg-cosmos-950 p-3">
              <div class="h-10 w-full rounded bg-[#EEEEEE] mb-2"></div>
              <div class="font-bold text-cosmos-950 font-bold bg-[#EEEEEE] px-1 rounded text-center mb-1">Starlight</div>
              <div class="text-slate-400">#EEEEEE</div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>
