---
import Layout from '../../layouts/Layout.astro';
import MascotRocket from '../../components/MascotRocket.astro';
---

<Layout
  title="Press Kit | Agogpixel Studio"
  description="Agogpixel Studio media assets, studio facts, brand assets, and press information."
>
  <div class="py-16 md:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 rounded-full border border-cyber-cyan/30 bg-void-900/80 px-4 py-1.5 font-mono text-xs text-cyber-cyan mb-4">
          <span>Media & Resources</span>
        </div>
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl font-sans">
          Press Kit
        </h1>
        <p class="mt-4 text-slate-300 text-base sm:text-lg">
          Everything you need to cover Agogpixel Studio, our games, and brand assets.
        </p>
      </div>

      <div class="space-y-12">
        <!-- Studio Factsheet -->
        <section class="rounded-2xl border border-void-800 bg-void-900/40 p-6 md:p-8">
          <h2 class="text-xl font-bold text-white font-sans mb-4">Factsheet</h2>
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-xs">
            <div class="rounded-lg border border-void-800 bg-void-950 p-3">
              <dt class="text-slate-400">Studio Name</dt>
              <dd class="text-white font-bold mt-1">Agogpixel Studio</dd>
            </div>
            <div class="rounded-lg border border-void-800 bg-void-950 p-3">
              <dt class="text-slate-400">Founders</dt>
              <dd class="text-white font-bold mt-1">kidthales & Antigravity (AI Co-Founder)</dd>
            </div>
            <div class="rounded-lg border border-void-800 bg-void-950 p-3">
              <dt class="text-slate-400">Website</dt>
              <dd class="text-cyber-cyan font-bold mt-1">
                <a href="https://agogpixel.com" target="_blank">agogpixel.com</a>
              </dd>
            </div>
            <div class="rounded-lg border border-void-800 bg-void-950 p-3">
              <dt class="text-slate-400">Primary Focus</dt>
              <dd class="text-white font-bold mt-1">Retro Sci-Fi Arcade Games & Curious Software</dd>
            </div>
            <div class="rounded-lg border border-void-800 bg-void-950 p-3">
              <dt class="text-slate-400">Primary Engine</dt>
              <dd class="text-white font-bold mt-1">Godot 4.4 Engine</dd>
            </div>
            <div class="rounded-lg border border-void-800 bg-void-950 p-3">
              <dt class="text-slate-400">Flagship Title</dt>
              <dd class="text-cyber-flame font-bold mt-1">Escape from Cygnus X-1</dd>
            </div>
          </dl>
        </section>

        <!-- Studio Description / Boilerplate -->
        <section class="rounded-2xl border border-void-800 bg-void-900/40 p-6 md:p-8">
          <h2 class="text-xl font-bold text-white font-sans mb-4">Studio Boilerplate</h2>
          <div class="rounded-xl border border-void-800 bg-void-950 p-4 text-sm text-slate-300 leading-relaxed font-sans">
            "Agogpixel Studio is an independent game development studio creating high-velocity retro sci-fi arcade experiences with tight physics and authentic game feel. Pair-founded by human creative director kidthales and autonomous AI agent Antigravity, Agogpixel adheres to the 'A-' Standard: delivering lean, high-rigor engineering while building and sharing every step of the journey in public."
          </div>
        </section>

        <!-- Brand & Mascot Assets -->
        <section class="rounded-2xl border border-void-800 bg-void-900/40 p-6 md:p-8">
          <h2 class="text-xl font-bold text-white font-sans mb-4">Branding & Mascot Assets</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div class="rounded-xl border border-void-800 bg-void-950 p-4 flex flex-col items-center text-center">
              <div class="h-24 flex items-center justify-center">
                <img src="/assets/rocket_guinea_pig.png" alt="Mascot Rocket PNG" class="h-16 w-16 object-contain" />
              </div>
              <div class="font-mono text-xs text-white font-bold mt-2">Mascot Rocket (PNG)</div>
              <a href="/assets/rocket_guinea_pig.png" download class="mt-3 font-mono text-xs text-cyber-cyan hover:underline">
                Download PNG ↓
              </a>
            </div>

            <div class="rounded-xl border border-void-800 bg-void-950 p-4 flex flex-col items-center text-center">
              <div class="h-24 flex items-center justify-center">
                <img src="/assets/rocket_guinea_pig.svg" alt="Mascot Rocket SVG" class="h-16 w-16 object-contain" />
              </div>
              <div class="font-mono text-xs text-white font-bold mt-2">Vector Rocket (SVG)</div>
              <a href="/assets/rocket_guinea_pig.svg" download class="mt-3 font-mono text-xs text-cyber-cyan hover:underline">
                Download SVG ↓
              </a>
            </div>

            <div class="rounded-xl border border-void-800 bg-void-950 p-4 flex flex-col items-center text-center">
              <div class="h-24 flex items-center justify-center">
                <MascotRocket size="sm" animated={true} />
              </div>
              <div class="font-mono text-xs text-white font-bold mt-2">Animated Mascot</div>
              <a href="/assets/rocket_guinea_pig_animated.gif" download class="mt-3 font-mono text-xs text-cyber-cyan hover:underline">
                Download GIF ↓
              </a>
            </div>
          </div>
        </section>

        <!-- Brand Color Palette -->
        <section class="rounded-2xl border border-void-800 bg-void-900/40 p-6 md:p-8">
          <h2 class="text-xl font-bold text-white font-sans mb-4">Studio Color Palette</h2>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 font-mono text-xs">
            <div class="rounded-xl border border-void-800 bg-void-950 p-3">
              <div class="h-10 w-full rounded bg-[#00f0ff] mb-2"></div>
              <div class="font-bold text-white">Cyber Cyan</div>
              <div class="text-slate-400">#00F0FF</div>
            </div>
            <div class="rounded-xl border border-void-800 bg-void-950 p-3">
              <div class="h-10 w-full rounded bg-[#c97320] mb-2"></div>
              <div class="font-bold text-white">Thruster Flame</div>
              <div class="text-slate-400">#C97320</div>
            </div>
            <div class="rounded-xl border border-void-800 bg-void-950 p-3">
              <div class="h-10 w-full rounded bg-[#a855f7] mb-2"></div>
              <div class="font-bold text-white">Neon Purple</div>
              <div class="text-slate-400">#A855F7</div>
            </div>
            <div class="rounded-xl border border-void-800 bg-void-950 p-3">
              <div class="h-10 w-full rounded bg-[#030308] border border-void-800 mb-2"></div>
              <div class="font-bold text-white">Deep Void</div>
              <div class="text-slate-400">#030308</div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>
