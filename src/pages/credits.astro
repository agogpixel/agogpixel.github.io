---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Credits & Attributions | Agogpixel"
  description="Credits, licenses, and attributions for third-party typography and color schemes used on agogpixel.com."
  scrollable={true}
>
  <article class="ap-prose">
    <header>
      <h1>Credits &amp; Attributions</h1>
      <p>
        Attribution and licensing details for third-party typography and color schemes powering this
        site.
      </p>
    </header>

    <section aria-labelledby="typography-heading">
      <h2 id="typography-heading">Typography</h2>

      <h3>Inter</h3>
      <ul>
        <li><strong>Copyright:</strong> &copy; 2016 The Inter Project Authors.</li>
        <li><strong>License:</strong> SIL Open Font License, Version 1.1 (OFL-1.1).</li>
        <li><strong>Full License Text:</strong> Available locally at <a href="/credits/OFL.txt">/credits/OFL.txt</a>.</li>
        <li><strong>Upstream Repository:</strong> <a href="https://github.com/rsms/inter" rel="external noopener noreferrer">rsms/inter</a>.</li>
      </ul>

      <h3>JetBrains Mono</h3>
      <ul>
        <li><strong>Copyright:</strong> &copy; 2020 The JetBrains Mono Project Authors.</li>
        <li><strong>License:</strong> SIL Open Font License, Version 1.1 (OFL-1.1).</li>
        <li><strong>Full License Text:</strong> Available locally at <a href="/credits/OFL.txt">/credits/OFL.txt</a>.</li>
        <li><strong>Upstream Repository:</strong> <a href="https://github.com/JetBrains/JetBrainsMono" rel="external noopener noreferrer">JetBrains/JetBrainsMono</a>.</li>
      </ul>
    </section>

    <section aria-labelledby="color-schemes-heading">
      <h2 id="color-schemes-heading">Color Schemes</h2>
      <p>
        <strong>Paul Tol&rsquo;s Colour Schemes</strong>
      </p>
      <ul>
        <li><strong>Author:</strong> Paul Tol (SRON).</li>
        <li><strong>Description:</strong> Colorblind-safe qualitative, diverging, and sequential palettes informing our high-contrast dark-cosmos interface tokens.</li>
        <li><strong>Reference:</strong> <a href="https://sronpersonalpages.nl/~pault/" rel="external noopener noreferrer">sronpersonalpages.nl/~pault</a>.</li>
      </ul>
    </section>
  </article>
</Layout>
