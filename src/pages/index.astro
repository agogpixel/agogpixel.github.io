---
import GameEmbedCard from '../components/GameEmbedCard.astro';
import { getPublishedCatalogGames } from '../data/games';
import Layout from '../layouts/Layout.astro';

const publishedGames = getPublishedCatalogGames();
const hasPublishedGames = publishedGames.length > 0;
---

<Layout
  title="Agogpixel | Curious Software Development"
  description="An A- Studio. Curious Software Development."
  scrollable={hasPublishedGames}
>
  <section class="ap-hero" aria-labelledby="hero-title">
    <div class="ap-hero-inner">
      <div class="ap-hero-media">
        <picture>
          <source
            srcset="/assets/rocket_guinea_pig.svg"
            media="(prefers-reduced-motion: reduce)"
          />
          <img
            src="/assets/rocket_guinea_pig_animated.svg"
            alt="Agogpixel Rocket Guinea Pig"
            width="320"
            height="320"
            class="ap-hero-mascot"
            loading="eager"
          />
        </picture>
      </div>

      <hgroup class="ap-hero-heading-group">
        <p class="ap-badge">[ An A- Studio ]</p>
        <h1 id="hero-title" class="ap-hero-title">AGOGPIXEL</h1>
        <p class="ap-hero-motto">Curious Software Development</p>
      </hgroup>
    </div>
  </section>

  {hasPublishedGames && (
    <section class="ap-catalog" aria-labelledby="catalog-heading">
      <header class="ap-catalog-header">
        <h2 id="catalog-heading" class="ap-catalog-heading">Games</h2>
      </header>
      <div class="ap-catalog-list">
        {publishedGames.map((game) => (
          <GameEmbedCard game={game} />
        ))}
      </div>
    </section>
  )}
</Layout>
