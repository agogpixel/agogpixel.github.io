---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Agogpixel | Curious Software Development"
  description="An A- Studio. Curious Software Development."
>
  <section class="ap-hero" aria-labelledby="hero-title">
    <div class="ap-hero-inner">
      <div class="ap-hero-media">
        <img
          src="/assets/rocket_guinea_pig_animated.svg"
          alt="Agogpixel Rocket Guinea Pig"
          width="320"
          height="320"
          class="ap-hero-mascot"
          loading="eager"
        />
      </div>

      <hgroup class="ap-hero-heading-group">
        <p class="ap-badge">[ An A- Studio ]</p>
        <h1 id="hero-title" class="ap-hero-title">AGOGPIXEL</h1>
        <p class="ap-hero-motto">Curious Software Development</p>
      </hgroup>
    </div>
  </section>
</Layout>
