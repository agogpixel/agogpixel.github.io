---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Agogpixel Studio | Curious Software Development"
  description="Independent game studio. AAA ambition. Indie grit. Minus the corporate bloat."
>
  <!-- Jumbotron / Hero Section -->
  <section class="relative min-h-[calc(100vh-140px)] flex flex-col items-center justify-center overflow-hidden px-4 py-16 sm:px-6 lg:px-8">
    <!-- Ambient Space Glow -->
    <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
      <div class="h-[500px] w-[500px] rounded-full bg-brand-cyan/10 blur-[120px] filter"></div>
      <div class="h-[400px] w-[400px] rounded-full bg-brand-amber/15 blur-[100px] filter -translate-x-24 translate-y-24"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-4xl text-center flex flex-col items-center">
      <!-- Animated Rocket Guinea SVG from agogpixel-studio -->
      <div class="mb-10 relative flex items-center justify-center">
        <div class="absolute -inset-4 rounded-full bg-brand-amber/15 blur-2xl pointer-events-none"></div>
        <img
          src="/assets/rocket_guinea_pig_animated.svg"
          alt="Agogpixel Rocket Guinea Pig"
          class="relative h-64 w-64 sm:h-80 sm:w-80 md:h-96 md:w-96 object-contain select-none filter drop-shadow-[0_0_30px_rgba(201,115,32,0.3)] transition-transform duration-300"
          loading="eager"
        />
      </div>

      <!-- Studio Tagline Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-cyan/30 bg-cosmos-900/90 px-4 py-1.5 font-mono text-xs text-brand-cyan mb-6 shadow-sm shadow-brand-cyan/10">
        <span class="inline-block h-2 w-2 rounded-full bg-brand-cyan animate-pulse"></span>
        <span>Independent Game Studio</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-6xl md:text-7xl text-brand-starlight font-sans">
        AGOGPIXEL<span class="text-brand-cyan">.</span>
      </h1>

      <!-- Studio Motto & Tagline -->
      <p class="mt-4 font-mono text-lg sm:text-xl text-brand-amber tracking-wide">
        Curious Software Development
      </p>

      <p class="mt-4 max-w-xl text-base sm:text-lg text-slate-300 leading-relaxed font-sans">
        AAA ambition. Indie grit. Minus the corporate bloat.
      </p>
    </div>
  </section>
</Layout>
