---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/theme.css';
import '../styles/site.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  scrollable?: boolean;
}

const {
  title = 'Agogpixel | Curious Software Development',
  description = 'An A- Studio. Curious Software Development.',
  image = '/assets/rocket_guinea_pig.png',
  noindex = false,
  scrollable = false,
} = Astro.props;

let pathname = Astro.url.pathname;
if (!pathname.endsWith('/')) {
  pathname += '/';
}
const siteBase = Astro.site ?? 'https://agogpixel.com';
const canonicalURL = new URL(pathname, siteBase);
const ogImageURL = new URL(image, siteBase);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; manifest-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src https://itch.io https://store.steampowered.com"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>

    {!noindex && <link rel="canonical" href={canonicalURL.href} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="description" content={description} />

    <!-- Preload primary roman woff2 font (same origin, crossorigin) -->
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.href} />

    <!-- Twitter Meta -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="ap-app">
    <a href="#main" class="ap-skip-to-content">Skip to content</a>
    <Header />
    <main
      id="main"
      tabindex="-1"
      class:list={[
        'ap-main',
        scrollable ? 'ap-main--scrollable' : 'ap-main--centered',
      ]}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
