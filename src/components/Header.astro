---
---

<header class="w-full border-b border-cosmos-800/80 bg-cosmos-950/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <!-- Brand / Logo -->
    <a href="/" class="group flex items-center gap-3 transition-transform hover:scale-[1.02]">
      <div class="relative flex h-10 w-10 items-center justify-center rounded-lg border border-brand-cyan/30 bg-cosmos-900 p-1 shadow-sm shadow-brand-cyan/20">
        <img src="/assets/rocket_guinea_pig.png" alt="Agogpixel Logo" class="h-8 w-8 object-contain" />
      </div>
      <div class="flex flex-col">
        <span class="font-mono text-base font-bold tracking-wider text-brand-starlight group-hover:text-brand-cyan transition-colors">
          AGOGPIXEL<span class="text-brand-cyan">.</span>
        </span>
        <span class="text-[10px] uppercase tracking-widest text-slate-400 font-mono -mt-1">Studio</span>
      </div>
    </a>

    <!-- Status badge -->
    <div class="flex items-center gap-2 font-mono text-xs text-brand-cyan bg-cosmos-900/90 border border-brand-cyan/30 px-3 py-1 rounded-full shadow-sm shadow-brand-cyan/10">
      <span class="inline-block h-2 w-2 rounded-full bg-brand-cyan animate-pulse"></span>
      <span class="hidden sm:inline">Curious Software Development</span>
      <span class="sm:hidden">Studio</span>
    </div>
  </div>
</header>
