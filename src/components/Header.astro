---
const pathname = Astro.url.pathname;
---

<header class="ap-header">
  <nav aria-label="Primary navigation" class="ap-nav">
    <ul>
      <li class="ap-brand-item">
        <a
          href="/"
          class="ap-brand"
          aria-current={pathname === '/' ? 'page' : undefined}
        >
          <img
            src="/assets/pixel/rocket_guinea_pig_pixel.svg"
            alt=""
            width="32"
            height="32"
            class="ap-brand-logo"
          />
          <span>AGOGPIXEL</span>
        </a>
      </li>
    </ul>
  </nav>
</header>
