---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-cosmos-600 bg-cosmos-950 py-4 text-brand-lunar">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono">
      <div class="flex items-center gap-2">
        <img
          src="/assets/pixel/rocket_guinea_pig_pixel.svg"
          alt="Agogpixel"
          class="h-5 w-5 object-contain"
        />
        <span class="text-brand-starlight font-bold tracking-wide">
          AGOGPIXEL
        </span>
        <span class="text-brand-charcoal">|</span>
        <span class="text-brand-lunar">Curious Software Development</span>
      </div>

      <div class="flex items-center gap-4 text-brand-lunar">
        <a href="/devlogs" class="text-brand-lunar hover:text-brand-cyan transition-colors">
          Devlogs
        </a>
        <span class="text-cosmos-600">&bull;</span>
        <a href="/rss.xml" class="text-brand-lunar hover:text-brand-amber-ui transition-colors">
          RSS
        </a>
        <span class="text-cosmos-600">&bull;</span>
        <span>&copy; {currentYear} Agogpixel</span>
      </div>
    </div>
  </div>
</footer>
