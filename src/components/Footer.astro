---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-void-800/80 bg-void-950/90 py-12 text-slate-400">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      <!-- Studio Intro -->
      <div class="space-y-4 md:col-span-2">
        <div class="flex items-center gap-2">
          <img src="/assets/rocket_guinea_pig.png" alt="Agogpixel" class="h-6 w-6 object-contain" />
          <span class="font-mono text-base font-bold tracking-wide text-slate-100">
            AGOGPIXEL STUDIO
          </span>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-slate-400">
          Independent game development studio exploring retro mechanics, modern arcade game feel, and AI-accelerated autonomous engineering. 
        </p>
        <div class="flex items-center gap-2 font-mono text-xs text-cyber-cyan/90">
          <span class="inline-block h-2 w-2 rounded-full bg-cyber-cyan animate-pulse"></span>
          <span>Building an "A-" Studio in Public</span>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-200">Navigation</h3>
        <ul class="mt-4 space-y-2 font-mono text-sm">
          <li>
            <a href="/" class="hover:text-cyber-cyan transition-colors">Home</a>
          </li>
          <li>
            <a href="/games/" class="hover:text-cyber-cyan transition-colors">Games Showcase</a>
          </li>
          <li>
            <a href="/devlogs/" class="hover:text-cyber-cyan transition-colors">Engineering Devlogs</a>
          </li>
          <li>
            <a href="/about/" class="hover:text-cyber-cyan transition-colors">Studio & Manifesto</a>
          </li>
          <li>
            <a href="/presskit/" class="hover:text-cyber-cyan transition-colors">Press Kit</a>
          </li>
        </ul>
      </div>

      <!-- Studio Links & Specs -->
      <div>
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-200">Connect & Source</h3>
        <ul class="mt-4 space-y-2 font-mono text-sm">
          <li>
            <a
              href="https://github.com/agogpixel"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-cyber-cyan transition-colors"
            >
              GitHub Organization ↗
            </a>
          </li>
          <li>
            <a
              href="https://github.com/agogpixel/agogpixel.github.io"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-cyber-cyan transition-colors"
            >
              Portal Repository ↗
            </a>
          </li>
          <li>
            <span class="text-xs text-slate-500 font-mono">Engine: Godot 4.4 | Web: Astro v5</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 border-t border-void-800 pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 font-mono gap-4">
      <div>
        &copy; {currentYear} Agogpixel Studio. All rights reserved.
      </div>
      <div class="flex items-center gap-4">
        <span>Custom Domain: agogpixel.com</span>
        <span>•</span>
        <span class="text-slate-400">Human + AI Pair Founded</span>
      </div>
    </div>
  </div>
</footer>
