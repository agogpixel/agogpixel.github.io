---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-cosmos-800 bg-cosmos-950 py-4 text-slate-400">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono">
      <div class="flex items-center gap-2">
        <img src="/assets/rocket_guinea_pig.png" alt="Agogpixel" class="h-5 w-5 object-contain" />
        <span class="text-brand-starlight font-bold tracking-wide">
          AGOGPIXEL
        </span>
        <span class="text-slate-600">|</span>
        <span class="text-slate-400">Curious Software Development</span>
      </div>

      <div class="flex items-center gap-4 text-slate-500">
        <a href="/devlogs" class="text-slate-400 hover:text-brand-cyan transition-colors">
          Devlogs
        </a>
        <span class="text-cosmos-700">&bull;</span>
        <a href="/rss.xml" class="text-slate-400 hover:text-brand-amber transition-colors">
          RSS
        </a>
        <span class="text-cosmos-700">&bull;</span>
        <span>&copy; {currentYear} Agogpixel</span>
      </div>
    </div>
  </div>
</footer>
