---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-cosmos-800 bg-cosmos-950 py-12 text-slate-400">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      <!-- Studio Intro -->
      <div class="space-y-4 md:col-span-2">
        <div class="flex items-center gap-2">
          <img src="/assets/rocket_guinea_pig.png" alt="Agogpixel" class="h-6 w-6 object-contain" />
          <span class="font-mono text-base font-bold tracking-wide text-brand-starlight">
            AGOGPIXEL STUDIO
          </span>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-slate-400 font-sans">
          Independent game development studio crafting retro sci-fi arcade experiences, tight mechanics, and curious software.
        </p>
        <div class="flex items-center gap-2 font-mono text-xs text-brand-cyan">
          <span class="inline-block h-2 w-2 rounded-full bg-brand-cyan animate-pulse"></span>
          <span>AAA ambition. Indie grit. Minus the corporate bloat.</span>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-200">Navigation</h3>
        <ul class="mt-4 space-y-2 font-mono text-sm">
          <li>
            <a href="/" class="hover:text-brand-cyan transition-colors">Home</a>
          </li>
          <li>
            <a href="/games/" class="hover:text-brand-cyan transition-colors">Games</a>
          </li>
          <li>
            <a href="/devlogs/" class="hover:text-brand-cyan transition-colors">Devlogs</a>
          </li>
          <li>
            <a href="/about/" class="hover:text-brand-cyan transition-colors">About & Manifesto</a>
          </li>
          <li>
            <a href="/presskit/" class="hover:text-brand-cyan transition-colors">Press Kit</a>
          </li>
        </ul>
      </div>

      <!-- Studio Links & Specs -->
      <div>
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-slate-200">Connect</h3>
        <ul class="mt-4 space-y-2 font-mono text-sm">
          <li>
            <a
              href="https://github.com/agogpixel"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-brand-cyan transition-colors"
            >
              GitHub Organization ↗
            </a>
          </li>
          <li>
            <a
              href="https://github.com/agogpixel/agogpixel.github.io"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-brand-cyan transition-colors"
            >
              Web Portal Source ↗
            </a>
          </li>
          <li>
            <span class="text-xs text-slate-500 font-mono">Curious Software Development</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 border-t border-cosmos-800 pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 font-mono gap-4">
      <div>
        &copy; {currentYear} Agogpixel Studio. All rights reserved.
      </div>
      <div class="flex items-center gap-4">
        <span>agogpixel.com</span>
        <span>•</span>
        <span class="text-slate-400">An "A-" Independent Studio</span>
      </div>
    </div>
  </div>
</footer>
