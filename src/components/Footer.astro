---
const currentYear = new Date().getFullYear();
const pathname = Astro.url.pathname;
---

<footer class="ap-footer">
  <div class="ap-footer-inner">
    <div class="ap-footer-brand">
      <img
        src="/assets/pixel/rocket_guinea_pig_pixel.svg"
        alt=""
        width="20"
        height="20"
        class="ap-footer-logo"
      />
      <span class="ap-footer-name">AGOGPIXEL</span>
      <span class="ap-footer-sep" aria-hidden="true">|</span>
      <span>Curious Software Development</span>
    </div>

    <div class="ap-footer-meta">
      <a
        href="/credits/"
        class="ap-footer-link"
        aria-current={pathname === '/credits/' ? 'page' : undefined}
      >
        Credits
      </a>
      <span class="ap-footer-dot" aria-hidden="true">&bull;</span>
      <span>&copy; {currentYear} Agogpixel</span>
    </div>
  </div>
</footer>
