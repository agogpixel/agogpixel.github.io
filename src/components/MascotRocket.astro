---
export interface Props {
  size?: 'sm' | 'md' | 'lg';
  variant?: 'vector' | 'pixel';
  class?: string;
}

const {
  size = 'md',
  variant = 'vector',
  class: className = '',
} = Astro.props;

const sizeMap = {
  sm: 'h-16 w-16',
  md: 'h-32 w-32',
  lg: 'h-64 w-64',
};

const assetMap = {
  vector: '/assets/rocket_guinea_pig_animated.svg',
  pixel: '/assets/pixel/rocket_guinea_pig_pixel.svg',
};

const src = assetMap[variant] || assetMap.vector;
---

<div class:list={['inline-flex items-center justify-center select-none', className]}>
  <img
    src={src}
    alt="Agogpixel Rocket Guinea Pig"
    class:list={['object-contain select-none', sizeMap[size] || sizeMap.md]}
    loading="eager"
  />
</div>
